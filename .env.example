NODE_ENV=development
PORT=3000

JWT_SECRET=       # générer : node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"

# Cluster MongoDB Atlas partagé — chaîne fournie dans le context pack Digital Factory
# Ne jamais installer MongoDB en local, ne jamais committer la valeur réelle
DB_URL=
DB_NAME=          # convention cd_<projet> — nom validé avec la Digital Factory

# Laisser vide en développement : la DF renseigne les origines au déploiement
CORS_ORIGINS=